{
    "name": "cliniqo/cliniqo-api",
    "type": "project",
    "description": "Cliniqo Medical - Multi-Tenant Medical Clinic Management REST API",
    "keywords": ["laravel", "cliniqo", "medical", "saas", "multi-tenant", "cnss", "clinic-management"],
    "license": "proprietary",
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
